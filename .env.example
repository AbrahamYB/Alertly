# Alertly Environment Configuration

# Server
PORT=3000
NODE_ENV=production

# AI Assistant Chat (Groq or OpenAI-compatible provider)
CHAT_AI_PROVIDER=groq
CHAT_AI_BASE_URL=https://api.groq.com/openai/v1
CHAT_AI_MODEL=openai/gpt-oss-20b
CHAT_AI_API_KEY=your-groq-api-key-here
CHAT_AI_WEB_SEARCH=true

# AI Report Moderation & Vision Verification
REPORT_AI_PROVIDER=groq
REPORT_AI_BASE_URL=https://api.groq.com/openai/v1
REPORT_AI_VISION_MODEL=qwen/qwen3.8-27b
REPORT_AI_TEXT_MODEL=openai/gpt-oss-20b
REPORT_AI_API_KEY=your-groq-api-key-here

# Automated Feeds
ENABLE_AUTOMATION=true
HAZARDS_FILE=/app/data/hazards.geojson
HAZARD_BBOX=-180,-60,180,85
HAZARD_REFRESH_HOURS=12
# NASA FIRMS API key for active fire hotspots (optional)
# FIRMS_MAP_KEY=your-nasa-firms-key
